    "stickyReadOnly": { "x": 6100, "y": 0, "w": 420, "text": "结构：图标轨 + 列表 + 看板。看板只放最值得关心的：需要处理、运行中、今天的波纹日历。其余信息收进悬停或点开的浮层。控制台没有编辑和运行控制按钮，变更交给 Agent。", "fill": "orange", "page": "web" },
    "stickyRunStates": { "x": 4600, "y": 1420, "w": 420, "text": "区域按数据出现：没有上报结果就没有结果区，没有产物就没有文件区，未声明阶段就不画阶段条。列表里的状态只用图形，文字在悬停提示和读屏标签里。", "fill": "blue", "page": "web" },
    "stickyAgentPanels": { "x": 4600, "y": 2000, "w": 420, "text": "Agent 面板：任务清单声明 panels（metric、bars、breakdown、table、text），数据来自运行上报的结果，渲染在任务和运行看板上。平台只渲染这几种声明式类型，不执行 HTML。需要改清单 Schema 和 OpenAPI 契约。", "fill": "purple", "page": "web" },
