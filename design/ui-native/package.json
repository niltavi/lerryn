{
  "name": "@lerryn/ui-native",
  "version": "0.1.0",
  "private": true,
  "description": "Lerryn 的 React Native 组件库：HeroUI Native + Uniwind 上的 Niltavi 主题与领域组件。",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./styles/theme.css",
