# 常用命令。运行 `make help` 查看说明。

GO      ?= go
PNPM    ?= pnpm
IMAGE   ?= ghcr.io/niltavi/lerryn
VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
COMMIT  ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo none)
DATE    ?= $(shell date -u +%Y-%m-%dT%H:%M:%SZ)

BUILDINFO := github.com/niltavi/lerryn/server/internal/buildinfo
LDFLAGS   := -s -w -X $(BUILDINFO).Version=$(VERSION) -X $(BUILDINFO).Commit=$(COMMIT) -X $(BUILDINFO).Date=$(DATE)

# 测试用 PostgreSQL。存储层测试读取这两个变量选择数据库。
LERRYN_TEST_POSTGRES_DSN ?= postgres://lerryn:lerryn@localhost:5432/lerryn_test?sslmode=disable

# OpenAPI 契约：api/openapi/ 是源文件，打包结果是 Go 和 TS 两端生成的输入。
API_SRC    := api/openapi/openapi.yaml
API_BUNDLE := api/bundled/openapi.yaml
REDOCLY    := $(PNPM) exec redocly
SPECTRAL   := $(PNPM) exec spectral
# 自部署项目的构建不向外发送统计。
export REDOCLY_TELEMETRY := off
export REDOCLY_SUPPRESS_UPDATE_NOTICE := true

# Web 控制台：apps/web 的构建产物复制到 server/internal/console/webdist/，由 go:embed 嵌入二进制。
WEB_DIST     := apps/web/dist
CONSOLE_DIST := server/internal/console/webdist

.PHONY: help check generate generate-check api-bundle api-lint lint vet test test-sqlite test-pg test-integration vulncheck typecheck test-web e2e-web e2e-mobile web build build-go image compose-check tidy notices notices-check release-image release-binaries

help: ## 列出所有命令
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk -F ':.*## ' '{printf "  %-18s %s\n", $$1, $$2}'

check: api-lint lint vet test vulncheck typecheck test-web notices-check website-check ## 合并前的全部检查（CI 另外跑 generate-check 和 test-pg）

generate: api-bundle ## 重新生成代码：打包 OpenAPI，运行 go:generate，再生成 TS 类型
	$(GO) generate ./...
	$(PNPM) --filter @lerryn/api generate
	node packages/api/scripts/generate.mjs api/spikes/s2/openapi.yaml api/spikes/s2/ts/schema.gen.ts

generate-check: generate ## 生成后检查工作区有无差异，用于 CI
	@git diff --exit-code || (echo "生成物与源文件不一致，请运行 make generate 并提交结果" && exit 1)
	@test -z "$$(git status --porcelain --untracked-files=all)" || (git status --short && echo "生成了未跟踪的文件" && exit 1)

api-bundle: ## 用 Redocly 把 api/openapi/ 打包成 api/bundled/openapi.yaml
	@mkdir -p $(dir $(API_BUNDLE))
	$(REDOCLY) bundle $(API_SRC) --config api/redocly.yaml --component-renaming-conflicts-severity error -o $(API_BUNDLE:.yaml=.tmp.yaml)
	@{ echo '# Code generated by redocly bundle from $(API_SRC). DO NOT EDIT.'; cat $(API_BUNDLE:.yaml=.tmp.yaml); } > $(API_BUNDLE)
	@rm -f $(API_BUNDLE:.yaml=.tmp.yaml)

api-lint: api-bundle ## Spectral 检查 OpenAPI 规范（规则见 api/.spectral.yaml）
	$(SPECTRAL) lint --ruleset api/.spectral.yaml --fail-severity=warn --display-only-failures $(API_BUNDLE)

lint: ## golangci-lint（含 gofmt、goimports、gosec）
	golangci-lint run ./...

vet: ## go vet
	$(GO) vet ./...

test: test-sqlite ## 单元测试，默认使用 SQLite

test-sqlite: ## 用 SQLite 跑测试
	LERRYN_TEST_DATABASE=sqlite $(GO) test -race ./...

test-pg: ## 用 PostgreSQL 跑测试，需要 LERRYN_TEST_POSTGRES_DSN 指向可用的测试库
	LERRYN_TEST_DATABASE=postgres LERRYN_TEST_POSTGRES_DSN='$(LERRYN_TEST_POSTGRES_DSN)' $(GO) test -race ./...

# Process-level suites build the server in a subprocess. Go's test cache
# cannot track all those production sources or the current Docker state.
test-integration: ## 需要 Docker 的集成测试（build tag: integration，每次实际运行）
	$(GO) test -race -count=1 -tags integration ./...

vulncheck: ## 依赖漏洞扫描
	$(GO) tool govulncheck ./...

typecheck: ## 前端 TypeScript 类型检查（含 S2 验证的类型断言）
	$(PNPM) typecheck
	$(PNPM) --filter @lerryn/api exec tsc -p ../../api/spikes/s2/ts/tsconfig.json

test-web: ## 前端单元测试（Vitest：@lerryn/core、@lerryn/ui-web、@lerryn/web、@lerryn/mobile）
	$(PNPM) design:test
	$(PNPM) --filter @lerryn/core --filter @lerryn/ui-web --filter @lerryn/web --filter @lerryn/mobile test

e2e-web: web ## Web 控制台端到端测试：Playwright 对真实的 all-in-one，需要 Docker 和 Chromium，不在 check 中（见 apps/web/e2e/README.md）
	$(PNPM) --filter @lerryn/web exec playwright install chromium
	$(PNPM) --filter @lerryn/web e2e

e2e-mobile: web ## 移动端端到端测试：Expo Go 在已启动的 iOS 模拟器上对真实的 all-in-one，配对时需在模拟器上点一次「登录」（见 apps/web/e2e/README.md）
	node apps/mobile/e2e/flow.ts

web: ## 构建 Web 控制台，并放到服务端嵌入的位置
	$(PNPM) --filter @lerryn/web build
	@find $(CONSOLE_DIST) -mindepth 1 ! -name .keep -exec rm -rf {} +
	cp -R $(WEB_DIST)/. $(CONSOLE_DIST)/

build: web build-go ## 构建 bin/lerryn（含 Web 控制台）

build-go: ## 只构建 Go 二进制，嵌入 webdist/ 中已有的控制台（没有时控制台页面返回 503）
	CGO_ENABLED=0 $(GO) build -trimpath -ldflags '$(LDFLAGS)' -o bin/lerryn ./server/cmd/lerryn

image: ## 构建本机架构的镜像
	docker build --build-arg VERSION=$(VERSION) --build-arg COMMIT=$(COMMIT) --build-arg DATE=$(DATE) -t $(IMAGE):dev .

compose-check: ## 用 docker compose config 检查 deploy/ 下的 Compose 文件
	docker compose -f deploy/single-node/compose.yaml --env-file deploy/single-node/.env.example config -q
	docker compose -f deploy/multi-node/compose.yaml --env-file deploy/multi-node/.env.example --profile runners config -q
	LERRYN_SERVER_URL=https://lerryn.example.com docker compose -f deploy/multi-node/runner-host.compose.yaml --env-file deploy/multi-node/.env.example config -q

tidy: ## 整理 go.mod
	$(GO) mod tidy

notices: ## 按 Go 模块和控制台的 npm 依赖重新生成 THIRD_PARTY_NOTICES
	node scripts/notices.mjs

notices-check: ## 检查 THIRD_PARTY_NOTICES 与依赖一致，许可证都在允许清单内
	node scripts/notices.mjs --check

# 发布构建，见 docs/release.md。默认只构建不推送；RELEASE_PUSH=1 才推送镜像。
release-image: ## 用 docker buildx 构建 linux/amd64、linux/arm64 镜像（RELEASE_PUSH=1 时推送）
	VERSION=$(VERSION) COMMIT=$(COMMIT) IMAGE=$(IMAGE) scripts/release.sh image

release-binaries: ## 构建 darwin、linux 的 amd64、arm64 二进制和 SHA256SUMS，输出到 dist/<版本>/
	VERSION=$(VERSION) COMMIT=$(COMMIT) scripts/release.sh binaries

.PHONY: website-check
website-check: ## 构建官网并检查元数据、资源链接和可访问性约束
	$(PNPM) website:build
	$(PNPM) website:check
	node --check website/assets/site.js
