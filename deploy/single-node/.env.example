# 复制为 .env 后修改。docker compose 会自动读取同目录下的 .env。

# 镜像与版本。内网部署时改成企业私有仓库的地址。
LERRYN_IMAGE=ghcr.io/niltavi/lerryn
LERRYN_VERSION=0.9.0

# 宿主机上 /var/run/docker.sock 所属组的 GID：stat -c %g /var/run/docker.sock
DOCKER_GID=999

# 用户和 Agent 访问控制台与 API 的地址，用来生成返回给 Agent 的控制台链接。
LERRYN_PUBLIC_URL=http://localhost:33333

# 可选。控制台的其他访问地址，逗号分隔，例如局域网地址之外的隧道域名 https://lerryn.example.com。
LERRYN_EXTRA_ORIGINS=

# 端口只绑定在本机。前面有反向代理时保持 127.0.0.1；直接对外提供服务时改成 0.0.0.0。
LERRYN_BIND=127.0.0.1
LERRYN_PORT=33333
