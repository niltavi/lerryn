# 复制为 .env 后修改。docker compose 会自动读取同目录下的 .env。

LERRYN_IMAGE=ghcr.io/niltavi/lerryn
LERRYN_VERSION=0.9.0

# 对外地址。填域名时 Caddy 自动申请证书，LERRYN_PUBLIC_URL 同时改成 https://<域名>。
LERRYN_SITE_ADDRESS=:80
LERRYN_PUBLIC_URL=http://localhost
LERRYN_HTTP_PORT=80
LERRYN_HTTPS_PORT=443

# 对象存储的桶名，与 server.yaml 的 storage.s3.bucket 保持一致。
LERRYN_S3_BUCKET=lerryn

# runner 所在宿主机上 /var/run/docker.sock 所属组的 GID：stat -c %g /var/run/docker.sock
DOCKER_GID=999
