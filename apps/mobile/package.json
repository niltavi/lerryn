{
  "name": "@lerryn/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Lerryn 的移动端：只读查看概览、任务和运行进度，扫码配对或用内置账号登录。",
  "license": "AGPL-3.0-only",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo start --ios",
    "android": "expo start --android",
    "export:ios": "expo export --platform ios --output-dir dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "0.4.1",
    "@expo-google-fonts/dm-sans": "0.4.2",
    "@gorhom/bottom-sheet": "5.2.14",
    "@tanstack/react-query": "5.105.2",
    "@lerryn/api": "workspace:*",
    "@lerryn/core": "workspace:*",
    "@lerryn/ui-native": "workspace:*",
    "expo": "~57.0.0",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "heroui-native": "1.0.10",
    "lucide-react-native": "1.58.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "uniwind": "1.12.2"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "~19.2.2",
    "jsdom": "30.1.3",
    "react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
