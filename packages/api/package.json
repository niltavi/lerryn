{
  "name": "@lerryn/api",
  "version": "0.1.0",
  "private": true,
  "description": "Lerryn 的 HTTP API 类型与客户端，由 api/ 下的 OpenAPI 规范生成。",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.gen.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
